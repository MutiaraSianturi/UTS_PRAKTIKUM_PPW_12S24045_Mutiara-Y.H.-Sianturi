# ==============================================================================
# 1. KONFIGURASI APLIKASI UTAMA
# ==============================================================================
APP_NAME="DEL-LEATS" 
APP_ENV=local
APP_KEY=                                 # Jalankan 'php artisan key:generate'
APP_DEBUG=true                           # Set TRUE agar error Whoops terlihat jelas
APP_URL=http://localhost:8000            # URL server lokal

# ==============================================================================
# 2. KONFIGURASI DATABASE
# ==============================================================================
DB_CONNECTION=mysql                      # Driver database
DB_HOST=127.0.0.1                        # IP local
DB_PORT=3306                             # Port default MySQL
DB_DATABASE=[ISI_NAMA_DATABASE_KAMU]    # Contoh: ppw_db / db_praktikum
DB_USERNAME=[ISI_USERNAME_MYSQL]        # XAMPP/Laragon default: root
DB_PASSWORD=[ISI_PASSWORD_MYSQL]        # XAMPP/Laragon default: KOSONGKAN

# ==============================================================================
# 3. KONFIGURASI FILESYSTEM & SESSION
# ==============================================================================
FILESYSTEM_DISK=public                   # Digunakan jika ada upload file/gambar
SESSION_DRIVER=file                      # Penyimpanan session keranjang/login



NSHS
FILESYSTEM_DISK = PUBLIC  
SESSION_DRIVER=FILE  #PENYIMPANAN SIESSION KERANJANG/LOGIN
DB_USERNAME = [INVENNTARIS RUANGAN REKAYASA PERANGKAT LUNAK]
DB_PASSWORD= [PERANBCANGAN MODEL-VIEW-CONTROLLER] {ALAM MENGHUBUNGKAN ANTAR antarmuka DENGAN PENGGUNA}
FILESYSTEM_DISK = KEYWORD